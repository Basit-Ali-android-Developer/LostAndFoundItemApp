<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:context=".LostAttributeFragment"
    android:orientation="vertical"
    >




    <TextView
        android:id="@+id/LostLocationtextview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lost Location"
        android:textColor="@color/black"
        android:textSize="15dp"
        android:textStyle="bold"
        android:layout_marginLeft="10dp"/>

    <EditText
        android:id="@+id/Llocation"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/edittext_background"
        android:ems="10"
        android:hint="Enter Lost Location"
        android:inputType="text"
        android:padding="12dp"
        android:textColor="#707070"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/LDtextview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lost Date"
        android:textColor="@color/black"
        android:textSize="15dp"
        android:textStyle="bold"
        android:layout_marginLeft="10dp"/>

    <EditText
        android:id="@+id/LDate"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/edittext_background"
        android:ems="10"
        android:hint="Enter Lost Date"
        android:inputType="date"
        android:padding="12dp"
        android:textColor="#707070"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/awardtextview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Award(optional)"
        android:textColor="@color/black"
        android:textSize="15dp"
        android:textStyle="bold"
        android:layout_marginLeft="10dp"/>

    <EditText
        android:id="@+id/AD"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/edittext_background"
        android:ems="10"
        android:hint="Enter award money"
        android:inputType="text"
        android:padding="12dp"
        android:textColor="#707070"
        android:textSize="15sp" />
    <TextView
        android:id="@+id/nominaltextview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nominate(optional)"
        android:textColor="@color/black"
        android:textSize="15dp"
        android:textStyle="bold"
        android:layout_marginLeft="10dp"/>

    <EditText
        android:id="@+id/Nominate"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/edittext_background"
        android:ems="10"
        android:hint="Enter Nominate if any"
        android:inputType="text"
        android:padding="12dp"
        android:textColor="#707070"
        android:textSize="15sp" />



</LinearLayout>