<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:context=".FoundAttributesFragment"
    android:orientation="vertical"
    >




        <TextView
            android:id="@+id/FoundLocationtextview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Found Location"
            android:textColor="@color/black"
            android:textSize="15dp"
            android:textStyle="bold"
            android:layout_marginLeft="10dp"/>

        <EditText
            android:id="@+id/Flocation"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/edittext_background"
            android:ems="10"
            android:hint="Enter Found Location"
            android:inputType="text"
            android:padding="12dp"
            android:textColor="#707070"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/FDtextview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Found Date"
            android:textColor="@color/black"
            android:textSize="15dp"
            android:textStyle="bold"
            android:layout_marginLeft="10dp"/>

        <EditText
            android:id="@+id/FDate"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/edittext_background"
            android:ems="10"
            android:hint="Enter Found Date"
            android:inputType="date"
            android:padding="12dp"
            android:textColor="#707070"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/epricetextview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estimated price"
            android:textColor="@color/black"
            android:textSize="15dp"
            android:textStyle="bold"
            android:layout_marginLeft="10dp"/>

        <EditText
            android:id="@+id/EP"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/edittext_background"
            android:ems="10"
            android:hint="Enter estimated price of item"
            android:inputType="text"
            android:padding="12dp"
            android:textColor="#707070"
            android:textSize="15sp" />


    </LinearLayout>

