<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@android:color/white"
    android:layout_marginBottom="20dp"
    android:layout_marginTop="20dp"
    android:layout_marginLeft="16dp"
    android:layout_marginRight="16dp"
    android:elevation="4dp"
    android:gravity="center">

    <!-- Note TextView (Header) for message (multi-line support) -->

    <ImageView
        android:id="@+id/itemImageView"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_placeholder"
        android:layout_marginEnd="10dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20sp"
        android:layout_marginTop="20sp"/>
    <!-- First TextBox for message (multi-line) -->
    <TextView
        android:id="@+id/Messagetextbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Message content goes here"
        android:textSize="16sp"
        android:textColor="@color/black"
        android:gravity="start"
        android:layout_marginBottom="10dp"
        android:layout_marginTop="8dp"
        android:paddingLeft="10dp"
        android:maxLines="3"
        android:ellipsize="end"/>

    <!-- TextBoxes for attributes -->

    <TextView
        android:id="@+id/attributestextbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Date: 2024-12-09"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"
        android:textColor="@color/black"
        android:gravity="start"
        android:paddingLeft="10dp"/>
    <TextView
        android:id="@+id/Maximum_biddertextbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="max_bider:"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"
        android:textColor="@color/black"
        android:gravity="start"
        android:paddingLeft="10dp"
        android:visibility="gone"/>
    <TextView
        android:id="@+id/Maximum_bidtextbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bid:"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"
        android:textColor="@color/black"
        android:gravity="start"
        android:paddingLeft="10dp"
        android:visibility="gone"/>


    <!-- Buttons (Accept and Reject) with enhanced design -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="10dp">

        <!-- Accept Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/ClaimButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Claim"
            android:background="@drawable/button_background"
            android:textColor="@android:color/white"
            android:padding="10dp"
            android:textSize="16sp"
            android:elevation="4dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="4dp"
            android:visibility="gone"/>

        <!-- Reject Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/rejectButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Reject"
            android:textColor="@android:color/white"
            android:background="@drawable/button_background"
            android:padding="12dp"
            android:textSize="16sp"
            android:elevation="4dp"
            android:layout_marginTop="4dp"
            android:visibility="gone"/>
    </LinearLayout>

</LinearLayout>
